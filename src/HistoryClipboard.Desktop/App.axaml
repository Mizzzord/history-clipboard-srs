<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HistoryClipboard.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI, SF Pro Text, Arial" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,9" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#4F46E5" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#4338CA" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="#B91C1C" /></Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="#4F46E5" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,10" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="4,2" /><Setter Property="CornerRadius" Value="8" /></Style>
  </Application.Styles>
</Application>
