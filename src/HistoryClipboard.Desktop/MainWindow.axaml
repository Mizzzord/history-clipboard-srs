<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:HistoryClipboard.Desktop"
        xmlns:core="using:HistoryClipboard.Core"
        x:Class="HistoryClipboard.Desktop.MainWindow"
        x:DataType="local:MainViewModel"
        Title="History Clipboard" Width="1060" Height="720" MinWidth="760" MinHeight="520"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="5">
        <TextBlock Text="History Clipboard" FontSize="26" FontWeight="SemiBold" Foreground="#172033" />
        <TextBlock Text="Скопировали. Сохранили. Нашли снова." Foreground="#667085" />
      </StackPanel>
      <Button Grid.Column="1" Content="{Binding PauseLabel}" Click="TogglePause" VerticalAlignment="Center" IsEnabled="{Binding CanToggle}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBox x:Name="SearchBox" Text="{Binding Query, Mode=TwoWay}" Watermark="Поиск по полному тексту…" AutomationProperties.Name="Поиск по истории" />
      <Button Grid.Column="1" Content="Очистить историю" Classes="danger" Click="ClearHistory" IsEnabled="{Binding CanClear}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <Border Background="White" CornerRadius="12" BorderBrush="#E4E7EC" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="16,14" ColumnDefinitions="*,Auto">
            <TextBlock Text="История" FontWeight="SemiBold" Foreground="#344054" />
            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="#667085" />
          </Grid>
          <Grid Grid.Row="1">
            <ListBox x:Name="HistoryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="4,0,4,8" AutomationProperties.Name="Записи истории">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:HistoryEntry">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#EEF2FF" VerticalAlignment="Top">
                      <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4F46E5" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Foreground="#172033" />
                      <TextBlock Text="{Binding DisplayDate}" FontSize="11" Foreground="#667085" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding ShowEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Spacing="8">
              <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#667085" MaxWidth="270" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E4E7EC" BorderThickness="1" Padding="18">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
          <StackPanel Spacing="5">
            <TextBlock Text="Полный текст" FontWeight="SemiBold" Foreground="#344054" />
            <TextBlock Text="{Binding SelectedDate}" FontSize="12" Foreground="#667085" />
          </StackPanel>
          <Grid Grid.Row="1">
            <TextBox Text="{Binding VisibleText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="#FAFAFC" Padding="12" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}" AutomationProperties.Name="Текст выбранной записи" />
            <TextBlock Text="Выберите запись слева, чтобы прочитать её целиком." IsVisible="{Binding NoSelection}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" TextAlignment="Center" Foreground="#667085" />
          </Grid>
          <StackPanel Grid.Row="2" IsVisible="{Binding ShowPages}" Spacing="6">
            <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="#667085" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Предыдущая часть" Click="PreviousPage" IsEnabled="{Binding CanPreviousPage}" />
              <Button Content="Следующая часть" Click="NextPage" IsEnabled="{Binding CanNextPage}" />
            </StackPanel>
          </StackPanel>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Content="Скопировать" Classes="primary" Click="CopyEntry" IsEnabled="{Binding CanAct}" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Удалить" Classes="danger" Click="DeleteEntry" IsEnabled="{Binding CanAct}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Spacing="9">
      <Border IsVisible="{Binding HasStorageError}" Background="#FEF3F2" CornerRadius="8" Padding="12">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding StorageError}" TextWrapping="Wrap" Foreground="#B42318" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Повторить открытие" Click="RetryStorage" />
            <Button Content="Начать новую историю" Click="ResetStorage" Classes="danger" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" Foreground="#344054" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Status}" Foreground="#475467" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="Только на этом устройстве" Foreground="#667085" FontSize="12" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
