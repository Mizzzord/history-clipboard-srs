@startuml
hide footbox
skinparam shadowing false
title Первый сеанс, пауза и очистка
actor Пользователь as U
participant MainWindow as UI
participant "Буфер ОС и CapturePolicy" as B
database HistoryStore as DB
U -> UI : Открыть приложение
UI -> DB : Открыть базу и загрузить список
UI --> U : Предупредить о сохранении личных данных
alt Согласие получено
  U -> UI : Понятно, начать
  UI -> B : Принять текущую версию за исходную
  U -> UI : Пауза
  UI -> B : Остановить наблюдение
  U -> B : Скопировать данные во время паузы
  U -> UI : Возобновить сбор
  UI -> B : Установить новую базовую версию
  note over UI,B : Текст, скопированный на паузе, пропускается.
  U -> UI : Очистить историю
  UI --> U : Запросить подтверждение
  alt Очистка подтверждена
    UI -> DB : Clear()
    DB --> UI : Записи и назначения меток удалены
    UI --> U : Показать пустую историю
  else Отмена
    UI --> U : Вернуться к списку
  end
else Закрыть приложение
  UI -> UI : Завершить работу до начала сбора
end
@enduml
